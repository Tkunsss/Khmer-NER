DATABASE_URL=mysql://USER:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-password

# The bundled Aiven CA certificate is used by default. To override it, set
# MYSQL_CA to the PEM certificate (multiline or with literal \n separators).
# MYSQL_CA=
